apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ include "nacos.fullname" .}}-naming-cm
data:
  MYSQL_SERVICE_HOST: {{ .Values.mysql.host | default .Values.naming.mysql.host }}
  MYSQL_SERVICE_DB_NAME: {{ .Values.mysql.db }}
  MYSQL_SERVICE_PORT: "{{ .Values.mysql.port  | default .Values.naming.mysql.port }}"