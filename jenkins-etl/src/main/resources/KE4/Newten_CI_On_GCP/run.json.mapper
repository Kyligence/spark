name=$.pipeline
id=$.id
startTime=replace(removeSuffix("\\$.startTime", 5), "T", " ")
endTime=replace(removeSuffix("\\$.endTime", 5), "T", " ")
runDate=removeSuffix("\\$.startTime", 18)
duration=$.durationInMillis
result=$.result
gitRepo=$.parameters[?(@.name=='ghprbGhRepository')].value
prNumber=$.parameters[?(@.name=='ghprbPullId')].value
prTitle=$.parameters[?(@.name=='ghprbPullTitle')].value
sourceBranch=$.parameters[?(@.name=='ghprbSourceBranch')].value
targetBranch=$.parameters[?(@.name=='ghprbTargetBranch')].value
commitAuthor=$.parameters[?(@.name=='ghprbActualCommitAuthor')].value
checkoutFailed=length("\\$.nodes[?(@.displayName=='Checkout' && @.result=='FAILURE')]")
compileFailed=length("\\$.nodes[?(@.displayName=='Compile' && @.result=='FAILURE')]")
testingFailed=length("\\$.nodes[?(@.displayName=='Testing' && @.result=='FAILURE')]")
sonarFailed=length("\\$.nodes[?(@.displayName=='Sonar Check' && @.result=='FAILURE')]")

#Module Test Duration
