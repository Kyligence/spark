name=$.pipeline
id=$.id
startTime=removeSuffix("\\$.startTime", 5)
endTime=removeSuffix("\\$.endTime", 5)
duration=$.durationInMillis
result=$.result
gitRepo=$.parameters[?(@.name=='ghprbGhRepository')].value
prNumber=$.parameters[?(@.name=='ghprbPullId')].value
prTitle=$.parameters[?(@.name=='ghprbPullTitle')].value
sourceBranch=$.parameters[?(@.name=='ghprbSourceBranch')].value
targetBranch=$.parameters[?(@.name=='ghprbTargetBranch')].value
commitAuthor=$.parameters[?(@.name=='ghprbActualCommitAuthor')].value
checkoutState=length("\\$.nodes[?(@.displayName=='Checkout Source Code' && @.result!='SUCCESS')]")
compileState=length("\\$.nodes[?(@.displayName=='Maven Install' && @.result!='SUCCESS')]")
testingState=length("\\$.nodes[?(@.displayName=='Testing' && @.result!='SUCCESS')]")
sonarState=length("\\$.nodes[?(@.displayName=='SonarCloud' && @.result!='SUCCESS')]")



