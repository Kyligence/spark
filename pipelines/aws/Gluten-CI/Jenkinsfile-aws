#!groovy

@Library('devopslib') _

pipeline {
    options {
        timestamps()
        timeout(time: 3, unit: 'HOURS')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/aws/Gluten-CI/jenkins-agent-gluten-ci.yaml'
        }
    }

    parameters {
        string(name: 'branch', defaultValue: 'add_clickhouse_source', description: 'gluten branch')
        string(name: 'glutenBot', defaultValue: 'https://open.feishu.cn/open-apis/bot/v2/hook/5f28fd33-08f1-49af-9738-cf93e3fafefd', description: 'gluten robot, send message to feishu chat group')
        string(name: 'sha1', defaultValue: '', description: '')
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                container('git') {
                    dir('gluten') {
                        //log: Running in /home/jenkins/agent/workspace/Gluten/gluten-ci/gluten

                        script {
                            def prBranch = env.sha1
//                            if (params.sha1) {
//                                prBranch = params.sha1
//                            }
                            sh 'env'
                            echo "clone gluten branch ${prBranch}"

                            githubCheckout 'gluten', prBranch, 'https', 'github.com', '+refs/pull/*:refs/remotes/origin/pr/* +refs/heads/*:refs/remotes/origin/*', 'kyligence-git', 'oap-project'

                            // def ch_source = "/tmp_workspace/build_${BUILD_NUMBER}"
                            // sh "git clone --recursive --depth 1 https://github.com/Kyligence/ClickHouse.git ${ch_source}"

                            sh 'ls'

                        }
                    }
                }
            }
        }

        stage('Make gluten repo copies') {
            steps {
                container('git') {
                    dir('gluten') {
                        //log: Running in /home/jenkins/agent/workspace/Gluten/gluten-ci/gluten
                        script {
                            sh script: """
                                cd ..
                                if [ -d "gluten2" ]
                                then
                                  rm -rf gluten2
                                fi
                                cp -r gluten gluten2
                            """
                        }
                    }
                }
            }
        }

        stage('Build LIBCH') {
            steps {
                container('libchbuilder') {
                    dir('gluten') {
                        //log: Running in /home/jenkins/agent/workspace/Gluten/gluten-ci/gluten
                        script {

                            sh script: """
                                export CCACHE_DIR=/ccache &&\
                                export CCACHE_BASEDIR=\${GLUTEN_SOURCE}/build &&\
                                export CCACHE_NOHASHDIR=true &&\
                                export CCACHE_COMPILERCHECK=content &&\
                                export CCACHE_MAXSIZE=15G &&\
                                export GLUTEN_SOURCE=\$(pwd) && \
                                cmake -G Ninja -S \${GLUTEN_SOURCE}/cpp-ch -B \${GLUTEN_SOURCE}/cpp-ch/_build -DCMAKE_C_COMPILER=clang-15 -DCMAKE_CXX_COMPILER=clang++-15 -DCMAKE_BUILD_TYPE=RelWithDebInfo &&\
                                cmake --build \${GLUTEN_SOURCE}/cpp-ch/_build --target build_ch\
                            """
                        }
                    }
                }
            }
        }

        stage('Parallel Unit Test') {
            parallel {
                stage('Gluten with Spark32') {
                    steps {
                        container("maven") {
                            dir("gluten") {
                                script {
                                    sh 'ls'
//                            sh script: "echo '/coredumps/core.%e.%p' | sudo tee /proc/sys/kernel/core_pattern"
                                    sh script: 'mkdir -p /data && tar -zxf /dataset/tpcds-data-sf1.tar.gz -C /data/'
                                    sh script: 'ls -al /data/tpcds-data-sf1'
                                    sh '''
                              if [ -d "/tmp/spark32" ]
                              then
                                rm -rf /tmp/spark32
                              fi
                              git clone --depth 1 --branch v3.2.2 https://github.com/apache/spark.git /tmp/spark32
                              '''
                                    try{
                                        sh '''
                                  export LD_PRELOAD=\${WORKSPACE}/gluten/cpp-ch/build/utils/extern-local-engine/libch.so
                                  export MAVEN_OPTS="-Xms1g -Xmx8g -Xss128m -XX:ReservedCodeCacheSize=1g"
                                  mvn clean test -Pbackends-clickhouse -Pspark-3.2 -Pspark-ut -Dtpcds.data.path=/data/tpcds-data-sf1 -Dclickhouse.lib.path=\${WORKSPACE}/gluten/cpp-ch/build/utils/extern-local-engine/libch.so -DargLine="-Dspark.test.home=/tmp/spark32"
                                '''
                                    }finally {
                                        echo 'enter finally'
                                        sh 'ls -l'
                                        sh 'pwd'
                                        sh 'mkdir -p /maven-log/\${BUILD_NUMBER}/3.2.2/backends-clickhouse'
                                        sh 'cp -r $(pwd)/backends-clickhouse /maven-log/\${BUILD_NUMBER}/3.2.2/backends-clickhouse'
                                        sh 'ls -l /maven-log/\${BUILD_NUMBER}/3.2.2/backends-clickhouse'

                                    }

                                }

                            }
                        }
                    }
                }
                stage('Gluten with Spark33') {
                    steps {
                        container("maven2") {
                            dir("gluten2") {
                                script {
                                    sh 'ls'
//                            sh script: "echo '/coredumps/core.%e.%p' | sudo tee /proc/sys/kernel/core_pattern"
                                    sh script: 'mkdir -p /data2 && tar -zxf /dataset/tpcds-data-sf1.tar.gz -C /data2/'
                                    sh script: 'ls -al /data2/tpcds-data-sf1'
                                    sh '''
                              if [ -d "/tmp/spark33" ]
                              then
                                rm -rf /tmp/spark33
                              fi

                              git clone --depth 1 --branch v3.3.1 https://github.com/apache/spark.git /tmp/spark33
                              '''
                                    try{

                                        sh '''
                                export MAVEN_OPTS="-Xms1g -Xmx8g -Xss128m -XX:ReservedCodeCacheSize=1g"
                                export LD_PRELOAD=\${WORKSPACE}/gluten/cpp-ch/build/utils/extern-local-engine/libch.so
                                mvn clean test -Pbackends-clickhouse -Pspark-3.3 -Pspark-ut -Dtpcds.data.path=/data2/tpcds-data-sf1 -Dclickhouse.lib.path=\${WORKSPACE}/gluten/cpp-ch/build/utils/extern-local-engine/libch.so -DargLine="-Dspark.test.home=/tmp/spark33"
                              '''
                                    }finally {
                                        echo 'enter finally'
                                        sh 'ls -l'
                                        sh 'pwd'
                                        sh 'mkdir -p /maven-log/\${BUILD_NUMBER}/3.3.1/backends-clickhouse'
                                        sh 'cp -r $(pwd)/backends-clickhouse /maven-log/\${BUILD_NUMBER}/3.3.1/backends-clickhouse'
                                        sh 'ls -l /maven-log/\${BUILD_NUMBER}/3.3.1/backends-clickhouse'

                                    }
                                }

                            }
                        }
                    }
                }
            }

        }
    }

    post {
        always {
            container('libchbuilder') {
                sh "rm -rf /tmp_workspace/build_${env.BUILD_NUMBER}"
            }
        }

        success {
            container('git') {
                script {
                    if (params.ghprbPullTitle && params.ghprbPullTitle.contains("[GLUTEN-1632][CH]")) {
                        feishu.glutenNotification("CI Passed (Gluten Rebase CH)", "${glutenBot}")
                    }
                }
            }
        }

        failure {
            container('git') {
                script {
                    if (params.ghprbPullTitle && params.ghprbPullTitle.contains("[GLUTEN-1632][CH]")) {
                        feishu.glutenNotification("CI failed (Gluten Rebase CH)", "${glutenBot}")
                    }
                }
            }
        }
    }
}


def quicklyCheckout() {
    if (params.sha1) {
        println "checkout from pull request."
        def pullNumber = matchPullNumber(params.sha1)
        checkout([$class: 'GitSCM', branches: [[name: params.sha1]], extensions: [[$class: 'CloneOption', depth: 1, honorRefspec: true, noTags: true, reference: '', shallow: true, timeout: 3]], userRemoteConfigs: [[credentialsId: 'kyligence-git', name: 'origin', refspec: "+refs/pull/${pullNumber}/*:refs/remotes/origin/pr/${pullNumber}/*", url: 'https://github.com/oap-project/gluten.git']]])
    } else if (params.branch) {
        println "checkout from specified branch."
        checkout([$class: 'GitSCM', branches: [[name: params.branch]], extensions: [[$class: 'CloneOption', depth: 1, honorRefspec: true, noTags: true, reference: '', shallow: true, timeout: 3]], userRemoteConfigs: [[credentialsId: 'kyligence-git', name: 'origin', refspec: "+refs/heads/${params.branch}:refs/remotes/origin/${params.branch}", url: 'https://github.com/oap-project/gluten.git']]])
    } else {
        throw new RuntimeException("unknown branch")
    }
}

@NonCPS
def matchPullNumber(String sha1) {
    def m = sha1 =~ /^origin\/pr\/(\d+)\/merge$/
    if (!m) {
        throw new RuntimeException("invalid sha1")
    }
    return m.group(1)
}
