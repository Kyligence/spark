    stages {
        stage('1.Sync Git Mirror') {
            steps {
                script {
                    syncGitMirror('KAP')
                    syncGitMirror('KAP_Frontend')
                }
            }
        }
        stage('2.Select Branch') {
            steps {
                script {
                    pull_code_result = pullCode(params)
                }
            }
        }
        stage('3.Parallel Building') {
            parallel {
                stage('NoSpark') {
                    when {
                        expression {
                            return !IS_DEBUG
                        }
                    }
                    stages {
                        stage('Pull NoSpark') {
                            when {
                                expression {
                                    return params.envStage in ['QA', 'RC', 'GA'] && !paramsMap['skipNoSpark']
                                }
                            }
                            steps {
                                container('build') {
                                    dir('sourcecode1') {
                                        script {
                                            // pull_result_nospark = pullCode(params)
                                            def cms = gitCodeKe(pull_code_result.release_branch_back, pull_code_result.release_branch_front, pull_code_result.paramsMap)
                                            pull_code_result.release_commitid_back = cms.release_commitid_back
                                            pull_code_result.release_commitid_front = cms.release_commitid_front
                                            pull_result_nospark = pull_code_result
                                        }
                                    }
                                }
                            }
                        }
                        stage('Building noSpark') {
                            when {
                                expression {
                                    return params.envStage in ['QA', 'RC', 'GA'] && !paramsMap['skipNoSpark']
                                }
                            }
                            steps {
                                container('build') {
                                    script {
                                        sh 'cat /root/.m2/settings.xml'
                                        def no_spark = true
                                        def bpns = buildPackage('sourcecode1', pull_result_nospark, params.version, params.kylinVersion, params.envStage, params.deployType, no_spark, params.docs_commitid, params.customerPkg, paramsMap)
                                        no_spark_package_info = bpns.no_spark_package_info
                                        println("build noSpark [no_spark_package_info]: ${no_spark_package_info.toString()}, no_spark: ${no_spark}")
                                        println("Download URL: https://package.kyligence.com/${no_spark_package_info.package_file}")
                                    }
                                }
                            }
                        }
                        stage('Upload Nospark to AWS S3') {
                            when {
                                expression {
                                    return params.envStage in ['QA', 'RC', 'GA'] && !paramsMap['skipNoSpark']
                                }
                            }
                            steps {
                                container('build2') {
                                    script {
                                        println("upload to AWS S3 in Global: ${no_spark_package_info.file_name}")
                                        uploadHelper.uploadAwsS3(no_spark_package_info.file_name, "packages/ke-without-spark/${no_spark_package_info.file_name}", 'kyligencecloud-ci', 'us-west-2', 'aws_global_s3_cp', 'sourcecode1')
                                        println("Download URL: https://package.kyligence.com/${no_spark_package_info.package_file}")
                                    }
                                }
                            }
                            post {
                                success {
                                    sendNotify('EMAIL',
                                            "[KE4] SUCCESSFUL to Upload the NOSPARK Tar to S3'",
                                            nospark_user_eamils,
                                            """<p>SUCCESSFUL: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]':</p>
                                <p>The Job upload the package ${no_spark_package_info.file_name} to the S3: bucket [kyligencecloud-ci]</p>
                                <p>It saved in the path of [/packages/ke-without-spark/], please check it and use! Tks!</p>"""
                                    )
                                }
                            }
                        }
                    }
                }
                stage('Normal') {
                    stages {
                        stage('Pull Normal') {
                            steps {
                                container('build2') {
                                    dir('sourcecode2') {
                                        script {
                                            // pull_result_withspark = pullCode(params)
                                            def cms = gitCodeKe(pull_code_result.release_branch_back, pull_code_result.release_branch_front, pull_code_result.paramsMap)
                                            pull_code_result.release_commitid_back = cms.release_commitid_back
                                            pull_code_result.release_commitid_front = cms.release_commitid_front
                                            pull_result_withspark = pull_code_result
                                        }
                                    }
                                }
                            }
                        }
                        stage('Building Normal') {
                            steps {
                                container('build2') {
                                    script {
                                        sh 'cat /root/.m2/settings.xml'
                                        def no_spark = false
                                        def bp = buildPackage('sourcecode2', pull_result_withspark, params.version, params.kylinVersion, params.envStage, params.deployType, no_spark, params.docs_commitid, params.customerPkg, paramsMap)
                                        package_info = bp.package_info
                                        println("build Normal [package_info]: ${package_info.file_name}, no_spark: ${no_spark}")
                                        println("Download URL: https://package.kyligence.com/${package_info.package_file}")
                                    }
                                }
                            }
                        }
                        stage('Scan Public API') {
                            when {
                                expression {
                                    return params.scanApi == true
                                }
                            }
                            steps {
                                container('build2') {
                                    timestamps {
                                        script {
                                            dir('sourcecode2') {
                                                sh script: """
                                                    ls -lh
                                                    wget https://repo-ofs.kyligence.com/repository/raw-tars-hosted/io.kyligence.ke/ke-api-inspector-release.tar.gz --directory-prefix=scanapi_workdir/
                                                    tar -zxvf ./${package_info.file_name} -C ./scanapi_workdir > /dev/null
                                                    tar -zxvf scanapi_workdir/ke-api-inspector-release.tar.gz -C ./scanapi_workdir > /dev/null

                                                    ls -lh scanapi_workdir
                                                    cd scanapi_workdir
                                                    ke_pkg_home="`pwd`/${package_info.ga_name - '.tar.gz'}"
                                                    cd ke-api-inspector-release
                                                    ./run.sh \$ke_pkg_home
                                                """

                                                publishHTML([allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true, reportDir: 'scanapi_workdir/ke-api-inspector-release/report', reportFiles: 'ke_api_inspect_report.html', reportName: 'API 扫描报告', reportTitles: "report from ${BUILD_NUMBER}"])
                                            }
                                        }
                                    }
                                }
                            }
