        string(name: 'version', defaultValue: '4.6.6.0', description: '填写版本号，格式：4.6.0.0，4.5.10.0，4.3.11.1.1，版本号由【数字和 . 】组合，最多5段，必须规范,\n特别提醒：选择QA打包阶段，版本号写错是无法匹配到对应分支的！！！')
        string(name: 'kylinVersion', defaultValue: '5.0.0', description: '填写版本号，格式：5.0.0，版本号由【数字和 . 】组合，最多5段！！！')
        choice(name: 'envStage', choices: 'DEV\nQA\nRC\nGA', description: '打包阶段，如果要GA，选择GA进行流程')
