            }
            steps {
                container('build2') {
                    script {
                        def checkMsg = "该版本可以GA吗？\n确认项：\n1.分支情况，前端 ${pull_result_withspark.release_branch_front}，后端 ${pull_result_withspark.release_branch_back};\n2.发布版本号：${params.version}"
                        println checkMsg
                        // sh 'printenv'
                        paramsGA = input(
                                message: checkMsg,
                                ok: '确认！',
                                submitter: 'liming.meng,meixiu.chen,lu.cao,chenqing.zhu',
                                submitterParameter: 'APPROVER',
                                parameters: [
                                        booleanParam(name: 'skipUpload', defaultValue: false, description: '是否跳过上传')
                                ]
                        )
                        ga_name = package_info.ga_name
                    }
                }
            }
        }
        stage('7.GA Upload') {
            when {
                expression {
                    return params.envStage == 'GA' && !paramsGA['skipUpload'] && !IS_DEBUG
                }
            }
            parallel {
                stage('GA AWS CN') {
                    steps {
                        script {
                            println("upload to S3 in AWS CN: ${ga_name}")
                            retry(2) {
                                uploadHelper.uploadAwsS3(ga_name, "product/kap/4.0.x/${ga_name}", 'download.kyligence.io', 'cn-north-1', 'aws_cn_s3_cp', 'sourcecode2')
                            }
                        }
                    }
                }
                stage('GA AWS Global') {
                    steps {
                        script {
                            println("upload to S3 in AWS Global: ${ga_name}")
                            retry(2) {
                                uploadHelper.uploadAwsS3(ga_name, "product/kap/4.0.x/${ga_name}", 'download.kyligence.io', 'us-west-1', 'aws_global_s3_cp', 'sourcecode2')
                            }
                        }
                    }
                }
                stage('GA Nexus') {
                    steps {
                        container('build') {
                            script {
                                println("upload to Nexus repo-ofs: ${ga_name}")
                                retry(2) {
                                    uploadHelper.uploadNexus(ga_name, 'product/ke/4.0.x', 'raw-ke-ga-tar-hosted', 'sourcecode2')
                                }
                            }
                        }
                    }
                }
                stage('Jars Nexus') {
                    when {
                        expression {
                            return params.envStage == 'GA' && params.customerPkg == 'NORMAL' && !IS_DEBUG
                        }
                    }
                    steps {
                        container('build2') {
                            script {
                                dir('sourcecode2') {
                                    sh 'mvn deploy -Pdev -DskipTests -T 4C'
                                }
                            }
                        }
                    }
                    post {
                        success {
                            sendNotify('EMAIL',
                                    "[KE4][RELEASE JAR] SUCCESSFUL to Upload the Jar to the product library [repo-ofs]'",
                                    jar_user_emails,
                                    """<p>SUCCESSFUL: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]':</p>
                                <p>The Job upload the RELEASE Jars into inner Product Library [repo-ofs]</p>
                                <p>It saved in the repository of [maven-release], please check it and use! Tks!</p>"""
                            )
                        }
                    }
                }
            }
        }
        stage('8.Git Tag') {
            when {
                expression {
                    return params.envStage == 'GA' && params.customerPkg == 'NORMAL' && !IS_DEBUG
                }
            }
            steps {
                container('build2') {
                    script {
                        def _tag = "ke-${version}"
                        dir('sourcecode2') {
                            println "backend: KAP push tag: ${_tag} on branch ${pull_result_withspark.release_branch_back} in sourcecode folder"
                            githubHelper 'TAG', pull_result_withspark.release_branch_back, 'KAP', _tag
                            bcid = sh(returnStdout: true, script: "git rev-parse HEAD | sed -e 's/\r//g'").trim()
                            println "backend [KAP] commitId: ${bcid}"

                            dir('kystudio') {
                                println "frontend: KAP_Frontend push tag: ${_tag} on branch ${pull_result_withspark.release_branch_front} in kystudio folder"
                                githubHelper 'TAG', pull_result_withspark.release_branch_front, 'KAP_Frontend', _tag
                                fcid = sh(returnStdout: true, script: "git rev-parse HEAD | sed -e 's/\r//g'").trim()
                                println "frontend [KAP_Frontend] commitId: ${fcid}"
                            }
                        }
                    }
                }
            }
            post {
                success {
                    script {
                        if (!IS_DEBUG) {
                            sendNotify(
                                    'EMAIL',
                                    "[KE4][GA] ${version} SUCCESSFUL GA",
                                    product_emails,
                                    """
                        <p>SUCCESSFUL: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]':</p>
                        <p>The Backend repo of [KAP] commitId: ${bcid}</p>
                        <p>The Frontend repo of [KAP_Frontend] commitId: ${fcid}</p>
                        <p>Automatically tag [ke-${version}] the front and back branches.</p>
                        <br />
                        <p>Download URL: <a href="https://repo-ofs.kyligence.com/repository/raw-public/product/ke/4.0.x/${ga_name}">${ga_name}</a></p>
                        """
                            )
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            container('build2') {
                script {
                    if (!IS_DEBUG) {
                        feishu('KE-All-CD-2.1打包失败！！')
                    }
                }
            }
        }
    }
}
