// 根据发布类型自动获取分支
def getBranch(deployType, envStage, version) {
    print "getBranch -> deployType[${deployType}],envStage[${envStage}],version[${version}]"
    def _result
    def _branch_release = ''
    def _branch_qa = ''
    def _branch_dev = ''
    def branchCollection = ['newten', 'ke-4.5.x-sp', 'ke-4.3.x', 'ke-4.3.x-sp', 'ke-4.5.x', 'newten-sp']

    switch (deployType) {
        case 'Regular':
            _branch_release = branchCollection[0]
            _branch_qa = "ke-${version}-qa"
            _branch_dev = "${_branch_release}-dev"
            break
        case 'SP-4.5.x':
            _branch_release = branchCollection[0]
            _branch_qa = "${branchCollection[1]}-dev"
            _branch_dev = "${branchCollection[1]}-dev"
            break
        case 'KE-4.3.x':
            _branch_release = branchCollection[2]
            _branch_qa = "ke-${version}-qa"
            _branch_dev = "${branchCollection[1]}-dev"
            break
        case 'SP-4.3.x':
            _branch_release = branchCollection[3]
            _branch_qa = "${_branch_release}-dev"
            _branch_dev = "${_branch_release}-dev"
            break
        case 'KE-4.5.x':
            _branch_release = branchCollection[4]
            _branch_qa = "${_branch_release}-qa"
            _branch_dev = "${_branch_release}-dev"
            break
        case 'SP-4.6.x':
            _branch_release = branchCollection[0]
            _branch_qa = "${branchCollection[5]}-dev"
            _branch_dev = "${branchCollection[5]}-dev"
            break
    }

    switch (envStage) {
        case 'DEV':
            _result = _branch_dev
            break
        case 'QA':
            _result = _branch_qa
            break
        case 'RC':
        case 'GA':
            _result = _branch_release
            break
    }
    echo "getBranch: ${_result}"
    return _result
}

def setVersions(version, kylinVersion, is_GA) {
    print "setVersions -> version[${version}],kylinVersion[${kylinVersion}],is_GA[${is_GA}]"
    def _version = version
    def _kylinVersion = "${kylinVersion}-ke-${_version}"
    if (!is_GA) {
        _version = "${version}-SNAPSHOT"
        _kylinVersion = "${kylinVersion}-ke-${_version}"
    }
    sh """
        mvn versions:set -DnewVersion=${_kylinVersion} -pl kylin

        sed -i 's/<kylin.module.version>.*<\\/kylin.module.version>/<kylin.module.version>${_kylinVersion}<\\/kylin.module.version>/g' pom.xml
        mvn versions:set -DnewVersion=${_version}
    """
}

// git获取KE代码（预先触发同步git mirror）
def gitCodeKe(back, front, pMap) {
    print "gitCodeKe -> back[${back}],front[${front}],pMap[${pMap}]"
    def result = [:]
    script {
        println "backend branch/commit: ${back}, frontend branch/commit: ${front}"
        if (!back) {
            error 'commitId_back 参数不能为空'
        }
        def _back_remote = pMap && pMap['back_remote']
        pullCodeFromGitMirrorNew 'KAP', back, _back_remote, 'Kyligence', '', false

        result.release_commitid_back = sh(returnStdout: true, script: "git rev-parse --short HEAD | sed -e 's/\r//g'").trim()
        println "result.release_commitid_back: ${result.release_commitid_back}"

        // sh 'ls -lha && ls -lha kystudio'
        sh 'rm -rf kystudio'
        // sh 'ls -lha'
        dir('kystudio') {
            // sh 'pwd && ls -lha'
            def _front_remote = pMap && pMap['front_remote']
            pullCodeFromGitMirrorNew 'KAP_Frontend', front, _front_remote, 'Kyligence', '', false

            result.release_commitid_front = sh(returnStdout: true, script: "git rev-parse --short HEAD | sed -e 's/\r//g'").trim()
            println "result.release_commitid_front: ${result.release_commitid_front}"
            // result.release_commitid_front = release_commitid_front
            sh """
                rm -f .npmrc
                echo "registry = 'https://repo-ofs.kyligence.com/repository/npm-public/'" > .npmrc
                cat .npmrc
            """
        }
    }
    return result
}

// pullCode(params)
def pullCode(params) {
    println "pullCode -> params[${params}]"
    def result = [:]
    // 1. 参数检查：version
    paramsVerify.version(params.version)
    // 2. 获取分支（前后端）
    if (params.deployWay == 'Auto Select') {
        // 2.1 根据分支流程规则，自动获取代码分支参数
        def _branch = getBranch(params.deployType, params.envStage, params.version)
        result.release_branch_front = _branch
        result.release_branch_back = _branch
        result.paramsMap = null
        // def cms = gitCodeKe(_branch, _branch, null)
        // result.release_commitid_back = cms.release_commitid_back
        // result.release_commitid_front = cms.release_commitid_front
    } else if (params.deployWay == 'Manual Select') {
        // 2.2 根据手动输入参数设定分支
        result.paramsMap = input(
                message: '请选择要开始的版本?',
                ok: '确认！',
                parameters: [
                        string(name: 'commitId_back', defaultValue: '', description: '后端Repo(KAP)的branch或者commitid（必填）注：填commitid的时候前端的必填'),
                        string(name: 'commitId_front', defaultValue: '', description: '前端repo(KAP_Frontend)的branch或者commitid（后端填分支名时，该参数可以不填）'),
                        booleanParam(name: 'overide', defaultValue: false, description: '全新打包，覆盖现有同名包'),
                        booleanParam(name: 'back_remote', defaultValue: false, description: '后端拉取远程分支（绕开 git mirror）'),
                        booleanParam(name: 'front_remote', defaultValue: false, description: '前端拉取远程分支（绕开 git mirror）'),
                        booleanParam(name: 'skipNoSpark', defaultValue: false, description: '勾选时，跳过打 NoSpark 包')
                ],
                // submitter:'liming.meng,admin',
                submitterParameter: 'APPROVER'
        )
        result.release_branch_front = result.paramsMap['commitId_front']
        result.release_branch_back = result.paramsMap['commitId_back']
        if (!result.release_branch_front) { //如果前端没填自动选择
            result.release_branch_front = getBranch(params.deployType, params.envStage, params.version)
        }
        if (!result.release_branch_back) {
            error('commitId_back参数必填')
        }
        // def cms = gitCodeKe(result.release_branch_back, result.release_branch_front, result.paramsMap)
        // result.release_commitid_back = cms.release_commitid_back
        // result.release_commitid_front = cms.release_commitid_front
    } else {
        error(message: '请选择足够的信息来确认代码分支')
    }
    println 'pullCode result: ' + result.toString()
    return result
}

def getPackageInfo(version, envStage, cid, deployType, noSpark = false, customerPkg = 'NORMAL') {
    println "getPackageInfo -> version[${version}],envStage[${envStage}],cid[${cid}],deployType[${deployType}],customerPkg[${customerPkg}]"
    def package_path
    def branchCollection = ['4.6.x', '4.5.x-sp', '4.3.x', '4.3.x-sp', '4.5.x', '4.6.x-sp']
    switch (deployType) {
        case 'Regular':
            package_path = "artifacts/${branchCollection[0]}/${envStage}"
            break
        case 'SP-4.5.x':
            package_path = "artifacts/${branchCollection[1]}/${envStage}"
            break
        case 'KE-4.3.x':
            package_path = "artifacts/${branchCollection[2]}/${envStage}"
            break
        case 'SP-4.3.x':
            package_path = "artifacts/${branchCollection[3]}/${envStage}"
            break
        case 'KE-4.5.x':
            package_path = "artifacts/${branchCollection[4]}/${envStage}"
            break
        case 'SP-4.6.x':
            package_path = "artifacts/${branchCollection[5]}/${envStage}"
            break
    }
    println "package_path: ${package_path}"

    def withoutSpark = noSpark ? '-NoSpark' : ''
    def _customerPkg = ''
    switch (customerPkg) {
        case 'NORMAL':
            _customerPkg = ''
            break
        case 'CUSTOMER_JIANHANG_HDP3':
            _customerPkg = '-CCB'
            break
        case 'CUSTOMER_GUANGDA_CDH5':
            _customerPkg = '-CEB'
            break
    }

    file_name = "KE-${version}-${cid}${withoutSpark}${_customerPkg}.tar.gz"
    package_file = "newten-cicd/${package_path}/${file_name}"
    ga_name = "Kyligence-Enterprise-${version}${withoutSpark}${_customerPkg}.tar.gz"

    println "file_name: ${file_name}"
    println "package_file: ${package_file}"
    println "ga_name: ${ga_name}"

    def obj = [:]
    obj.package_path = package_path
    obj.package_file = package_file
    obj.file_name = file_name
    obj.ga_name = ga_name
    if (envStage == 'GA') {
        obj.file_name = ga_name
        obj.package_file = "newten-cicd/${package_path}/${ga_name}"
    }
    println obj.toString()
    return obj
}

def checkCacheExist(pi) {
    println "checkCacheExist -> package_info[${pi}]"
    def result = false
    try {
        def existPackage = "${pi.package_path}/${pi.file_name}"
        sh script: """
            ls -l /var/cicd/${pi.package_path}
            cp /var/cicd/${existPackage} ${pi.file_name}
        """

        sh 'ls -l'
        println "pi.package_file: ${pi.package_file}"
        result = fileExists(pi.file_name)
        println "/var/cicd/${pi.package_path}/${pi.file_name} is ${result}"
    } catch (Exception err) {
        println "The package [${pi.file_name}] not exsits, the pipeline will make it next."
        result = false
        // println err.getMessage()
    }

    println "checkCacheExist result: ${result}"
    return result
}

def buildAndCopy(version, noSpark, pi, docs_commitid, customerPkg, excludeDocs) {
    println "buildAndCopy -> version[${version}],noSpark[${noSpark}],pi[${pi}],docs_commitid[${docs_commitid}],customerPkg[${customerPkg}],excludeDocs[${excludeDocs}]"
    // sh "git checkout -- ."
    buildNewten(version, noSpark, docs_commitid, customerPkg, excludeDocs)

    sh script: """
        mkdir -p /var/cicd/${pi.package_path}
        mv dist/*.tar.gz ${pi.file_name}
    """
    archiveArtifacts artifacts: "${pi.file_name}", fingerprint: true, followSymlinks: false, onlyIfSuccessful: true

    sh script: """
        cp ${pi.file_name} /var/cicd/${pi.package_path}
    """
}

// buildPackage(params.version, params.kylinVersion, params.envStage, params.deployType, params.noSpark, params.docs_commitid)
def buildPackage(path, pull_result, version, kylinVersion, envStage, deployType, noSpark, docs_commitid, customerPkg, pMap) {
    println "buildPackage -> path[${path}],pull_result[${pull_result}],version[${version}],kylinVersion[${kylinVersion}],envStage[${envStage}],deployType[${deployType}],noSpark[${noSpark}],customerPkg[${customerPkg}],pMap[${pMap}]"
    def result = [:]
    timestamps {
        script {
            def _version = "${version}-${envStage}"
            def _cids = "${pull_result.release_commitid_back}-${pull_result.release_commitid_front}"
            dir(path) {
                // 判断
                if (params.envStage == 'GA') {
                    setVersions(version, kylinVersion, true)
                }

                /**
                 * 打包条件描述（任何满足一个条件执行重新）：
                 * 1. 打包文件不存在；
                 * 2. 手动模式中选择了overide参数的；
                 * 3. GA版打包时；
                 */
                if (!noSpark) {
                    package_info = getPackageInfo(_version, envStage, _cids, deployType, noSpark, customerPkg)
                    if (!checkCacheExist(package_info) || pull_result['overide'] || envStage == 'GA') {
                        buildAndCopy(_version, noSpark, package_info, docs_commitid, customerPkg, params.excludeDocs)
                    }
                    result.package_info = package_info
                } else {
                    no_spark_package_info = getPackageInfo(_version, envStage, _cids, deployType, noSpark, customerPkg)
                    if (!checkCacheExist(no_spark_package_info) || pull_result['overide'] || envStage == 'GA') {
                        buildAndCopy(_version, noSpark, no_spark_package_info, docs_commitid, customerPkg, params.excludeDocs)
                    }
                    result.no_spark_package_info = no_spark_package_info
                    // sh "git checkout -- ."
                }
            }
        }
    }
    println 'buildPackage result: ' + result.toString()
    return result
}

pipeline {
    options {
        timeout(time: 24, unit: 'HOURS')
        ansiColor('xterm')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/yaml/jenkins-ke4-agent.yaml'
        }
    }

    environment {
