#!groovy

@Library('devopslib') _

pipeline {
    options {
        timeout(time: 1, unit: 'HOURS')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/yaml/jenkins-k8s-agent.yaml'
        }
    }

    parameters {
        string(name: 'branch', defaultValue: 'newten-qa', description: 'Kap branch?')
        string(name: 'repo', defaultValue: 'Kyligence', description: 'Kap repo?')
        string(name: 'version', defaultValue: '4.5.8.1', description: 'Kap version?')
        string(name: 'namespace', defaultValue: 'test', description: 'Kap version?')
        string(name: 'package_file', defaultValue: 'newten-cicd/artifacts/dev/Newten-CD/newten-qa-01fb10ea46-209-.tar.gz', description: 'Kap version?')
        credentials(name: 'certificate', credentialType: 'com.cloudbees.plugins.credentials.common.StandardCredentials', defaultValue: 'kyligence-git', required: true)
    }

    stages {
        stage('Build Package') {
            steps {
                echo 'nothing'
                sh "ls -al ."
            }
        }
        stage("Generate ENV") {
            steps {
                container("kubectl") {

                    withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                        echo "查看 K8S 集群 Pod 列表"
                        sh "mkdir -p ~/.kube && cp ${KUBECONFIG} ~/.kube/config"
                        sh "kubectl get pods"
                    
                    // retry(3) {
                        script {
                            result = sh (
                                returnStatus: true,
                                script: """#!/bin/sh
                                    set +x
                                    cd ${WORKSPACE}/k8s/auto-generate/
                                    sh install.sh --package_file=/data/jenkins-common/newten-cicd/artifacts/dev/NEWTEN-QA-INPUT-ID-CD/newten-qa-newten-qa-5.tar.gz --namespace=test-1
                                """
                            ).trim()
                            if(result == 0){
                                print 'SUCCESS'
                                currentBuild.result = 'SUCCESS'
                            }else{
                                print 'FAILED'
                                currentBuild.result = 'FAILED'
                            }
                        }
                    // }
                    }
                }
            }
        }
        stage('Building Package') {
            steps {
                echo 'nothing'
            }
        }
    }
}
