    stages {
        /* checkout repo */
        stage('Checkout SCM') {
            steps {
                sh "echo $ref"
                sh "printenv"
                container('build') {
                    dir('sourcecode') {
                        script {
                            githubCheckout 'springboot-helloworld', 'master', 'http', 'github.com', null, '', 'lexmeng'
                        }
                    }
                }
            }
        }
        stage('Do the deployment') {
            steps {
                echo ">> Run deploy applications "
                container('build') {
                    dir('sourcecode') {
                        sh 'mvn clean install -DskipTests'
                    }
                }
            }
        }
    }
 
    /* Cleanup workspace */
    post {
       always {
           deleteDir()
       }
    }

