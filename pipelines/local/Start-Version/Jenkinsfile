#!groovy

@Library('devopslib@nexus') _

def paramsMap

properties([pipelineTriggers([githubPush()])])

pipeline {
    
    options {
        timeout(time: 1, unit: 'HOURS')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/yaml/jenkins-package-agent.yaml'
        }
    }

    // parameters {
    // }

    // triggers {
    //     GenericTrigger(
