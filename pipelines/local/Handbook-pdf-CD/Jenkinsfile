#!groovy

@Library('devopslib') _

pipeline {

    options {
        timeout(time: 1, unit: 'HOURS')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/local/Handbook-pdf-CD/jenkins-agent.yaml'
        }
    }

    parameters {
        string(name: 'repo', defaultValue: 'Kyligence', description: 'Kap repo?', required: true)
        string(name: 'branch', defaultValue: 'master', description: 'Kap branch?', required: true)
        string(name: 'version', defaultValue: '', description: 'Kap version?', required: true)
        credentials(name: 'certificate', credentialType: 'com.cloudbees.plugins.credentials.common.StandardCredentials', defaultValue: 'kyligence-git', required: true)
    }

    stages {
        stage("Clone") {
            steps {
                container("git") {
                    dir("sourcecode") {
                        script {
                            retry(3) {
                                githubCheckout 'Kyligence-Enterprise-Manual', null, 'https', 'github.com', '+refs/heads/*:refs/remotes/origin/*'
                            }
                        }
                        sh("gitbook install")
                    }
                }
            }
        }
        stage('Deadline Checker') {
            steps {
                container("build") {
                    script{
                        try {
                            def sc_file = "pipelines/local/Handbook-pdf-CD/script/check_deadlinks.sh"
                            print sc_file
                            sh("ls -al pipelines/local/Handbook-pdf-CD/script/")
                            sh("chmod 744 ${sc_file}")
                            retry(3){
                                def checked = sh(script: "${sc_file}", returnStatus: true)
                            }
                        }
                        catch(ex){
                            echo ex.getMessage()
                        }
                    }
                }
            }
        }
        stage('Build') {
            steps {
                container("build") {
                    dir("sourcecode") {
                        sh (script:"""
                        gitbook build
                        gitbook pdf

                        mv book_en.pdf _book/en/Kyligence_Enterprise_4_5-en.pdf
                        rm -rf _book/zh-cn
                        mv _book/zh-hans _book/zh-cn
                        mv book_zh-hans.pdf _book/zh-cn/Kyligence_Enterprise_4_5-zh.pdf
                        """)

                        sh (script: """ls -al _book \
                        ls -al _book/en \
                        ls -al -book/zh-cn \
                        """)

                        def commitid = sh(script:"git rev-parse --short HEAD",returnStatus: true)
                        sh (script:"""
                        echo ${commitid}
                        cd _book/
                        tar -zcvf /var/cicd/handbook/Enterprise_v${version}-${BUILD_NUMBER}-${commitid}.tar.gz * > /dev/null
                        """)

                        sh("ls -al /var/cicd/handbook/")
                    }
                }
            }
        }
        stage('Upload') {
            steps {
                container("build") {
                    dir("sourcecode") {
                        println 'Upload'
                        sh("ls -al /var/cicd/handbook/")
                    }
                }
            }
        }
    }
}
