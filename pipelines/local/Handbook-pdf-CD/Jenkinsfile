#!groovy

@Library('devopslib') _

pipeline {
    options {
        timeout(time: 1, unit: 'HOURS')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/local/Handbook-pdf-CD/jenkins-agent.yaml'
        }
    }

    parameters {
        credentials(name: 'certificate', credentialType: 'com.cloudbees.plugins.credentials.common.StandardCredentials', defaultValue: 'kyligence-git', required: true)
        string(name: 'branch/commitid', defaultValue: 'master', description: 'Branch name or commit Id, which will be fetch the code.')
    }

    stages {
        stage("Checkout Source Code") {
            steps {
                echo "1.Checkout Source Code Stage"
                container("build") {
                    dir("sourcecode") {
                        script {
                            retry(3) {
                                githubCheckout 'Kyligence-Enterprise-Manua', 'newten', 'https', 'github.com', '+refs/heads/*:refs/remotes/origin/*'
                            }

                            //
                            // if (params.branch ==~ /.*yinglong.*/ ) {
                            //     echo 'checkout KAP_Frontend to kystudio'
                            //     sh 'rm -rf ./kystudio'
                            //     dir('kystudio') {
                            //         retry(3) {
                            //             githubCheckout 'KAP_Frontend', 'newten', 'https', 'github.com', '+refs/heads/*:refs/remotes/origin/*'
                            //         }
                            //     }
                            // }
                        }
                    }
                }
            }
        }
        stage('Building Package') {
            steps {
                echo "2.Building Package Stage"
                container("build") {
                    dir("sourcecode") {
                        sh "mkdir -p /var/cicd/handbook/ && \
                        ls "
                    }
                }
            }
        }
    }
}
