#!groovy

@Library('devopslib') _

pipeline {
    options {
        timeout(time: 1, unit: 'HOURS')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/local/Handbook-pdf-CD/jenkins-agent.yaml'
        }
    }

    parameters {
        string(name: 'repo', defaultValue: 'Kyligence', description: 'Kap repo?')
        string(name: 'commitid', defaultValue: 'newten-qa', description: 'Kap branch?')
        string(name: 'branch', defaultValue: 'master', description: 'Kap branch?')
        string(name: 'version', defaultValue: 'newten-qa', description: 'Kap version?')
        credentials(name: 'certificate', credentialType: 'com.cloudbees.plugins.credentials.common.StandardCredentials', defaultValue: 'kyligence-git', required: true)
        string(name: 'branch/commitid', defaultValue: 'master', description: 'Branch name or commit Id, which will be fetch the code.')
    }

    stages {
        stage("Clone") {
            steps {
                container("git") {
                    dir("sourcecode") {
                        script {
                            // 需要配置本地 git mirror 后才可用
                            // retry(3) {
                            //     sshCmdWithCredentials(
                            //         'bash -c /var/lib/git/pull.sh',
                            //         'private_git',
                            //         ['name':'localhost','host':'10.1.2.192', 'allowAnyHosts': true]
                            //     )
                            //     githubCheckout 'Kyligence-Enterprise-Manual'
                            // }

                            // retry(3) {
                            githubCloneBranch 'Kyligence-Enterprise-Manual', 'master', 'https', 'github.com', '+refs/heads/*:refs/remotes/origin/*', 90
                            // }
                            ls -l
                        }
                    }
                }
            }
        }
        stage('Deadline') {
            steps {
                container("build") {
                    dir("sourcecode") {
                        echo 'Deadline'
                    }
                }
            }
        }
        stage('Package') {
            steps {
                container("build") {
                    dir("sourcecode") {
                       echo 'Package'
                    }
                }
            }
        }
        stage('Upload') {
            steps {
                container("build") {
                    dir("sourcecode") {
                        echo 'Upload'
                    }
                }
            }
        }
    }
}
