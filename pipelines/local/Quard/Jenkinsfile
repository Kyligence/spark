    post {
        always {
            dir('quard') {
                sh script: '''
                    source ../venv/bin/activate

                    cat report.json

                    # 创建issue
                    python3 pipelines/kc_package/pipeline.py issue \
                            --jira-server="https://olapio.atlassian.net" \
                            --jira-user="tong.zheng@kyligence.io" \
                            --jira-token="bMyQbU0TBpAmJL3fpaHT7189" \
                            --report-file="report.json" \
                            --project-id="10040" \
                            --issue-type-id="10002" \
                            --label="Quard" \
                            --label="Regression_Bug" \
                            --priority-id="4" \
                            --title="[Quard][失败用例][{today}][{regtype_cn}] {test_case}"

                    # 创建飞书文档
                    deactivate
                    csv_file="quard_plan_result_total.csv"
                    export http_proxy="http://127.0.0.1:7890"
                    export https_proxy="http://127.0.0.1:7890"
                    aws s3 cp s3://flag2/quard/plan_result/${csv_file} ./ >> aws_s3_cp.log 2>&1
                    unset http_proxy https_proxy
                    source ../venv/bin/activate
                    python3 pipelines/kc_package/pipeline.py document --app-id="${feishu_app_id}" --app-secret="${feishu_app_secret}" --report-file="report.json" --csv-file="${csv_file}"
                    deactivate
                    export http_proxy="http://127.0.0.1:7890"
                    export https_proxy="http://127.0.0.1:7890"
                    aws s3 cp ./${csv_file} s3://flag2/quard/plan_result/${csv_file} >> aws_s3_cp.log 2>&1
                    unset http_proxy https_proxy
                    source ../venv/bin/activate

                    # 发送通知
                    if [ ! -z $(echo "${notify}" | grep "@kyligence.io") ]; then
                        python3 pipelines/kc_package/pipeline.py notify --type="user" --app-id="${feishu_app_id}" --app-secret="${feishu_app_secret}" --user-email="${notify}" --report-file="report.json"
                    elif [ ! -z $(echo "${notify}" | grep "https://") ]; then
                        python3 pipelines/kc_package/pipeline.py notify --type="group" --app-id="${feishu_app_id}" --app-secret="${feishu_app_secret}" --webhook="${notify}" --report-file="report.json"
                    else  # 根据群聊名称来发送通知
                        python3 pipelines/kc_package/pipeline.py notify --type="interactive" --app-id="${feishu_app_id}" --app-secret="${feishu_app_secret}" --chat-name="${notify}" --report-file="report.json"
                    fi
                '''
            }
        }
    }
    
