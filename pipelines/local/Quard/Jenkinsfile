                                    parameters="{\\"regtype\\": \\"${regtype}\\", \\"subtype\\": \\"compatibility\\", \\"version\\": \\"${ke_version}\\", \\"quard_repo\\": \\"Kyligence\\", \\"quard_branch\\": \\"quard-4.x-thd\\", \\"reuse_current_ke\\":\\"false\\", \\"compatibility\\":\\"true\\", \\"retry\\": \\"2\\", \\"select_tests\\": \\"\\"}"
