            parallel {
                stage("Local") {
                    steps {
                        dir('quard') {
                            script {
                                sh script: '''
                                   source ../venv/bin/activate

                                   parameters_1="{\\"deployWay\\": \\"Manual Select\\", \\"deployType\\": \\"Regular\\", \\"version\\": \\"${ke_version}\\", \\"envStage\\": \\"QA\\", \\"customerPkg\\": \\"NORMAL\\", \\"docs_commitid\\": \\"latest\\", \\"scanApi\\": \\"\\"}"
                                   parameters_2="{\\"commitId_back\\": \\"newten-dev\\", \\"commitId_front\\": \\"newten-dev\\", \\"overide\\": false, \\"back_remote\\": false, \\"front_remote\\": false, \\"skipNoSpark\\": false}"
                                   python3 pipelines/kc_package/pipeline.py build --server="https://cicd-ofs.kyligence.com" --username="tong.zheng" --token="117ce9d93aec1e60245e35890d1e2fe6c7" --job-name="KE4/KE-All-CD-2.0" --download-type="ke_and_nospark" --parameters="${parameters_1}" --input-submit-parameters="${parameters_2}" --job-url="${ke_job_url}" --version="${ke_version}" --regtype="${regtype}" --repo="KAP"

                                   # download ke
                                   cat download.txt
                                   package_name=$(head -n 1 download.txt | awk -F ',' '{print $1}')
                                   download_url=$(head -n 1 download.txt | awk -F ',' '{print $NF}')
                                   wget ${download_url} --no-check-certificate >> wget.log 2>&1

                                   # update license
                                   rm -rf Kyligence-Enterprise-Quard*
                                   mkdir -p Kyligence-Enterprise-Quard
                                   tar zxf ${package_name} -C Kyligence-Enterprise-Quard --strip-component 1
                                   cp /mnt/jenkins/quard_newten/license/LICENSE Kyligence-Enterprise-Quard/
                                   tar zcf Kyligence-Enterprise-Quard.tar.gz Kyligence-Enterprise-Quard/

                                   # copy file to netdisk
                                   cp Kyligence-Enterprise-Quard.tar.gz /mnt/jenkins/quard_newten/dist/

                                   # copy ke file to azure cdh6.3.2
                                   scp Kyligence-Enterprise-Quard.tar.gz quard@10.0.0.24:/mnt/jenkins/quard_newten/dist/

                                   # copy ke file to cdh5.16、cdh5.8
                                   rm -rf /mnt/jenkins/quard_newten/packages/4X_CDH5.16_ALL/r9999
                                   rm -rf /mnt/jenkins/quard_newten/packages/4X_CDH5.8_ALL/r9999
                                   mkdir -p /mnt/jenkins/quard_newten/packages/4X_CDH5.16_ALL/r9999
                                   mkdir -p /mnt/jenkins/quard_newten/packages/4X_CDH5.8_ALL/r9999
                                   cp Kyligence-Enterprise-Quard.tar.gz /mnt/jenkins/quard_newten/packages/4X_CDH5.16_ALL/r9999
                                   cp Kyligence-Enterprise-Quard.tar.gz /mnt/jenkins/quard_newten/packages/4X_CDH5.8_ALL/r9999
                                '''
                            }
                        }
                    }
                }
                stage("Upgrade") {
                    steps {
                        dir('quard') {
                            script {
                                sh script: '''
                                    mkdir -p upgrade_dir
                                    cd upgrade_dir
                                    # use system default python env to run awscli
                                    package_name=$(echo "${upgrade_package}" | awk -F '/' '{print $NF}')
                                    package_version=$(echo "${package_name}" | sed -E 's/.*-([\\.0-9]+)-.*/\\1/g')

                                    # download ke
                                    export http_proxy="http://127.0.0.1:7890"
                                    export https_proxy="http://127.0.0.1:7890"
                                    aws s3 cp ${upgrade_package} ./ >> aws_s3_cp.log 2>&1
                                    unset http_proxy https_proxy

                                    # update license
                                    rm -rf Kyligence-Enterprise-Quard/
                                    mkdir -p Kyligence-Enterprise-Quard/
                                    tar zxf ${package_name} -C Kyligence-Enterprise-Quard --strip-component 1
                                    cp /mnt/jenkins/quard_newten/license/LICENSE Kyligence-Enterprise-Quard/
                                    tar zcf Kyligence-Enterprise-Quard.tar.gz Kyligence-Enterprise-Quard/

                                    # copy old ke file to cdh5.16、cdh5.8
                                    rm -rf /mnt/jenkins/quard_newten/packages/4X_CDH5.16_ALL/${package_version}/
                                    rm -rf /mnt/jenkins/quard_newten/packages/4X_CDH5.8_ALL/${package_version}/
                                    mkdir -p /mnt/jenkins/quard_newten/packages/4X_CDH5.16_ALL/${package_version}/
                                    mkdir -p /mnt/jenkins/quard_newten/packages/4X_CDH5.8_ALL/${package_version}/
                                    cp Kyligence-Enterprise-Quard.tar.gz /mnt/jenkins/quard_newten/packages/4X_CDH5.16_ALL/${package_version}/
                                    cp Kyligence-Enterprise-Quard.tar.gz /mnt/jenkins/quard_newten/packages/4X_CDH5.8_ALL/${package_version}/
                                '''
                            }
                        }
                    }
                }
            }
