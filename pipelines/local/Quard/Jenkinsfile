        stage("Prepare") {
            steps {
                dir('quard') {
                    checkout([
                        $class:             'GitSCM',
                        branches:           [[name: env.githubbranch]],
                        userRemoteConfigs:  [[url: "https://${env.githubtoken}@github.com/${env.githubrepo}/kyQA-Quard.git"]],
                        browser:            [
                                                $class: 'GithubWeb',
                                                repoUrl: 'https://github.com/$'],
                        extensions:         [
                                                [$class: 'CleanBeforeCheckout'],
                                                [$class: 'CloneOption', depth: 0, noTags: false, shallow: false, timeout: 60]
                                            ]
                    ])
                }

                script {
                    sh script: '''
                        if [[ ! -d "venv" ]]; then
                            python3 -m venv venv
                            venv/bin/pip install -r ./quard/requirements.txt --no-index --find-links=/mnt/jenkins/quard_newten/pip_source
                        fi
                        source venv/bin/activate
                        pip install -r ./quard/requirements.txt --no-index --find-links=/mnt/jenkins/quard_newten/pip_source

                        rm -f quard.tar.gz
                        tar zcf quard.tar.gz quard/
                        scp quard.tar.gz quard@10.0.0.24:/mnt/jenkins/quard_newten/dist/
                    '''
                }
            }
        }

