                                <p>The Job upload the SNAPSHOT Jars into inner Product Library [repo-ofs]</p>
                                <p>It saved in the repository of [maven-snapshots], please check it and use! Tks!</p>"""
                            )
                        }
                    }
                }
            }
        }
        stage('5.Approve GA') {
            when {
                expression {
                    return params.envStage == 'GA' && params.customerPkg == 'NORMAL'
                }
            }
            steps {
                container('build') {
                    script {
                        def checkMsg = "该版本可以GA吗？\n确认项：\n1.分支情况，前端 ${release_branch_front}，后端 ${release_branch_back}\n2. 发布版本号：${params.version}"
                        println checkMsg
                        // sh 'printenv'
                        paramsGA = input(
                            message: checkMsg,
                            ok: '确认！',
                            submitter: 'liming.meng,meixiu.chen,lu.cao,chenqing.zhu',
