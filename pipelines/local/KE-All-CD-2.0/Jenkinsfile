// 根据发布类型自动获取分支
def getBranch(deployType, envStage, version) {
    print "getBranch -> deployType[${deployType}],envStage[${envStage}],version[${version}]"
    def _result
    def _branch_release = ''
    def _branch_qa = ''
    def _branch_dev = ''
    def branchCollection = ['newten', 'ke-4.5.x-sp', 'ke-4.3.x', 'ke-4.3.x-sp']

    switch (deployType) {
        case 'Regular':
            _branch_release = branchCollection[0]
            _branch_qa = "ke-${version}-qa"
            _branch_dev = "${_branch_release}-dev"
            break
        case 'SP-4.5.x':
            _branch_release = branchCollection[0]
            _branch_qa = "${branchCollection[1]}-dev"
            _branch_dev = "${branchCollection[1]}-dev"
            break
        case 'KE-4.3.x':
            _branch_release = branchCollection[2]
            _branch_qa = "ke-${version}-qa"
            _branch_dev = "${branchCollection[1]}-dev"
            break
        case 'SP-4.3.x':
            _branch_release = branchCollection[3]
            _branch_qa = "${_branch_release}-dev"
            _branch_dev = "${_branch_release}-dev"
            break
    }

    switch (envStage) {
        case 'DEV':
            _result = _branch_dev
            break
        case 'QA':
            _result = _branch_qa
            break
        case 'RC':
        case 'GA':
            _result = _branch_release
            break
    }
    echo "getBranch: ${_result}"
    return _result
}

// 上传制品包到Aws S3存储
def uploadAwsS3(region, credentials, bucket, path, ga_name, dir_name = 'sourcecode') {
    dir(dir_name) {
        timestamps {
            println("uploadAwsS3 -> path: ${path}, ga_name: ${ga_name}")
            withAWS(region: region, credentials: credentials) {
                s3Upload(bucket: bucket, path: path, file: ga_name)
            }
        }
    }
}

// 上传制品包到Nexus制品库
def uploadNexus(repo, package_path, file_name, dir_name = 'sourcecode') {
    timestamps {
        container('build') {
            dir(dir_name) {
                script {
                    println("repo: ${repo}, package_path: ${package_path}, file_name: ${file_name}")
                    // 上传制品库
                    withCredentials([usernamePassword(credentialsId: 'nexus-raw', passwordVariable: 'passwd', usernameVariable: 'user')]) {
                        pushRawArtifactsByApi(repo, package_path, file_name, file_name, user, passwd)
                    }
                }
            }
        }
    }
}

// 上传制品包到 Azure 服务器
def uplaodAzure(pi, dir_name = 'sourcecode', remote_path = '/home/4xuser/data/devops') {
    script {
        def remote = [:]
        remote.name = 'azure_test_env'
        withCredentials([usernamePassword(credentialsId: 'azure-4xuser',
                usernameVariable: 'REMOTE_USERNAME',
                passwordVariable: 'REMOTE_PASSWORD')]) {
            remote.user = REMOTE_USERNAME
            remote.password = REMOTE_PASSWORD
                }
        remote.host = '159.27.120.141'
        remote.allowAnyHosts = true
        dir(dir_name) {
            sshPut remote: remote, from: pi.file_name, into: remote_path
        }
        sshCommand remote: remote, command: """
            ls -lh ${remote_path}
        """
    }
}

// git获取KE代码（预先触发同步git mirror）
def gitCodeKe(back, front) {
    def result = [:]
    container('build') {
        dir('sourcecode') {
            script {
                println "backend branch/commit: ${back}, frontend branch/commit: ${front}"
                if (!back) {
                    error 'commitId_back 参数不能为空'
                }
                pullCodeFromGitMirror 'KAP', back

                release_commitid_back = sh(returnStdout: true, script: "git rev-parse --short HEAD | sed -e 's/\r//g'").trim()
                println "release_commitid_back: ${release_commitid_back}"
                result.release_commitid_back = release_commitid_back

                def _front
                if (!front) {
                    println "No commitId_front, use the commitId_back: ${back}"
                    _front = back
                } else {
                    println "checkout KAP_Frontend to kystudio, use the commitid: ${front}"
                    _front = front
                }

                sh 'rm -rf ./kystudio'
                dir('kystudio') {
                    pullCodeFromGitMirror 'KAP_Frontend', _front
                    release_commitid_front = sh(returnStdout: true, script: "git rev-parse --short HEAD | sed -e 's/\r//g'").trim()
                    println "release_commitid_front: ${release_commitid_front}"
                    result.release_commitid_front = release_commitid_front
                    sh """
                        rm -f .npmrc
                        echo "registry = 'https://repo-ofs.kyligence.com/repository/npm-public/'" > .npmrc
                        cat .npmrc
                        ls -lh .
                    """
                }
            }
        }
        // script {
        //     sh '''
        //         mkdir -p ./nospark && cp -r ./sourcecode/* ./nospark/
        //         ls -lh .
        //         echo "=========="
        //         ls -lh ./sourcecode
        //         echo "=========="
        //         ls -lh ./nospark
        //     '''
        // }
    }
    return result
}

def getPackageInfo(version, envStage, cid, deployType, noSpark = false) {
    println "getPackageInfo -> version[${version}],envStage[${envStage}],cid[${cid}],deployType[${deployType}]"
    def package_path
    def branchCollection = ['4.5.x', '4.5.x-sp', '4.3.x', '4.3.x-sp']
    switch (deployType) {
        case 'Regular':
            package_path = "artifacts/${branchCollection[0]}/${envStage}"
            break
        case 'SP-4.5.x':
            package_path = "artifacts/${branchCollection[1]}/${envStage}"
            break
        case 'KE-4.3.x':
            package_path = "artifacts/${branchCollection[2]}/${envStage}"
            break
        case 'SP-4.3.x':
            package_path = "artifacts/${branchCollection[3]}/${envStage}"
            break
    }
    println "package_path: ${package_path}"

    def withoutSpark = noSpark ? '-NoSpark' : ''
    def _customerPkg = params.customerPkg == 'NORMAL' ? '' : "-${params.customerPkg}"

    file_name = "KE-${version}-${cid}${withoutSpark}${_customerPkg}.tar.gz"
    package_file = "newten-cicd/${package_path}/${file_name}"
    ga_name = "Kyligence-Enterprise-${version}${withoutSpark}${_customerPkg}.tar.gz"

    println "file_name: ${file_name}"
    println "package_file: ${package_file}"
    println "ga_name: ${ga_name}"

    def obj = [:]
    obj.package_path = package_path
    obj.package_file = package_file
    obj.file_name = file_name
    obj.ga_name = ga_name
    println obj.toString()
    return obj
}

def checkCacheExist(pi) {
    println "checkCacheExist -> package_info[${pi}]"
    def result = false
    try {
        def existPackage = "${pi.package_path}/${pi.file_name}"
        sh script: """
            ls -l /var/cicd/${pi.package_path}
            cp /var/cicd/${existPackage} ${pi.file_name}
        """

        sh 'ls -l'
        println "pi.package_file: ${pi.package_file}"
        result = fileExists(pi.file_name)
        println "/var/cicd/${pi.package_path}/${pi.file_name} is ${result}"
    } catch (Exception err) {
        println "The package [${pi.file_name}] not exsits, the pipeline will make it next."
        result = false
        // println err.getMessage()
    }

    println "checkCacheExist result: ${result}"
    return result
}

def buildAndCopy(version, noSpark, pi, docs_commitid) {
    println "buildAndCopy -> version[${version}],noSpark[${noSpark}],pi[${pi}],docs_commitid[${docs_commitid}]"
    sh "git checkout -- ."
    buildNewten(version, noSpark, docs_commitid, params.customerPkg)

    sh script: """
        mkdir -p /var/cicd/${pi.package_path}
        mv dist/*.tar.gz ${pi.file_name}
    """
    // exist_package = true
    // archiveArtifacts artifacts: "${pi.file_name}", fingerprint: true, followSymlinks: false, onlyIfSuccessful: true

    if (envStage != 'GA') {
        sh script: """
            cp ${pi.file_name} /var/cicd/${pi.package_path}
        """
    } else {
        sh script: """
            cp ${pi.file_name} ${pi.ga_name}
            cp ${pi.ga_name} /var/cicd/${pi.package_path}
        """
        package_info.file_name = pi.ga_name
        no_spark_package_info.file_name = pi.ga_name
    }
}

// buildPackage(params.version, params.envStage, params.deployType, params.noSpark, params.docs_commitid)
def buildPackage(version, envStage, deployType, noSpark, docs_commitid) {
    println "buildPackage -> version[${version}],envStage[${envStage}],deployType[${deployType}],noSpark[${noSpark}]"
    def result = [:]
    container('build') {
        timestamps {
            script {
                def _version = "${version}-${envStage}"
                def _cids = "${release_commitid_back}-${release_commitid_front}"
                dir('sourcecode') {
                    if(!noSpark) {
                        package_info = getPackageInfo(_version, envStage, _cids, deployType, noSpark)
                        if(!checkCacheExist(package_info)) {
                            buildAndCopy(_version, noSpark, package_info, docs_commitid)
                        }
                        result.package_info = package_info
                    }else{
                        no_spark_package_info = getPackageInfo(_version, envStage, _cids, deployType, noSpark)
                        if(!checkCacheExist(no_spark_package_info)) {
                            buildAndCopy(_version, noSpark, no_spark_package_info, docs_commitid)
                        }
                        result.no_spark_package_info = no_spark_package_info
                    }
                }
            }
        }
    }
    println "buildPackage result: " + result.toString()
    return result
}

pipeline {
    options {
        timeout(time: 4, unit: 'HOURS')
        ansiColor('xterm')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/yaml/jenkins-package-agent.yaml'
        }
    }

    environment {
        //变量名，用于存储input步骤的返回值
        paramsMap = ''
        // GA过程参数
        paramsGA = ''
        // K8S启动用包名
        package_file = ''
        // 文件路径
        package_path = ''
        // 文件名(给测试过程中的名字)
        file_name = ''
        // github token
        GIT_JEKNINS_TOKEN = credentials('jenkins-token')
        no_spark = false
        // tester emails
        tester_emails = '''minhua.feng@kyligence.io;hao.huang@kyligence.io;ye.feng@kyligence.io;meixiu.chen@kyligence.io;guang.you@kyligence.io;junhui.deng@kyligence.io;
        fengjiao.wang@kyligence.io;ao.li@kyligence.io;huiling.li@kyligence.io;chenqing.zhu@kyligence.io;jiang.ren@kyligence.io;lu.sun@kyligence.io'''
        nospark_user_eamils = 'yong.fu@kyligence.io'
        jar_user_eamils = 'yongchao.li@kyligence.io'
        // dev eamils
        dev_regular_emails = 'enwei.jiao@kyligence.io;yifan.zhang@kyligence.io'
        dev_sp_emails = 'wei.chen@kyligence.io;yifan.zhang@kyligence.io'
        dev_front_emails = 'qian.xia@kyligence.io'
        // product emails
        product_emails = 'yong.zhao@kyligence.io;qian.jiang@kyligence.io;kaiqi.xue@kyligence.io;lina.liu@kyligence.io;xinxing.wu@kyligence.io;zhao.han@kyligence.io;yang.li@kyligence.io'
    }

    parameters {
        choice(name: 'deployWay', choices: 'Auto Select\nManual Select', description: '发布方式: \nAuto Select-根据发布类型自动选择分支; \nManual Select-手动选择分支、CommitId;')
        choice(name: 'deployType', choices: 'Regular\nKE-4.3.x\nSP-4.5.x\nSP-4.3.x', description: '交付版本流程:\nRegular - 指主线发布\nKE-4.3.x - 指对应4.3系列的发布\nSP-4.5.x - 指每周的版本发布4.5系列\nSP-4.3.x - 指每周的版本发布4.3系列')
        string(name: 'version', defaultValue: '4.5.10.0', description: '填写版本号，格式：4.5.10.0，4.3.11.1.1，版本号由【数字和 . 】组合，最多5段，必须规范,\n特别提醒：选择QA打包阶段，版本号写错是无法匹配到对应分支的！！！')
        choice(name: 'envStage', choices:'DEV\nQA\nRC\nGA', description:'打包阶段，如果要GA，选择GA进行流程' )
        choice(name: 'customerPkg', choices: ['NORMAL', 'CUSTOMER_JIANHANG_HDP3'], description:'指定客户定向包，NORMAL 为常规打包。若指定了定向包，会自动跳过 GA 上传步骤\n - CUSTOMER_JIANHANG_HDP3：建行\n' )
        string(defaultValue: 'latest', description: '指定要打包的文档 commitid（前 8 位）', name: 'docs_commitid')
        booleanParam(name: 'scanApi', defaultValue: false, description: '勾选时，将扫描产品包 API 是否有变更（注意：RC 包会自动强制扫描！）\n 扫描规则如下 https://kyligence.feishu.cn/wiki/wikcnL08pitXNyfO4omnIaf5mLh')
        // booleanParam(name: 'noSpark', defaultValue: false, description: '勾选时，打 NoSpark 包')
    }

    stages {
        stage('1.Pull Code') {
            steps {
                script {
                    // 1. 参数检查：version
                    paramsVerify.version(params.version)
                    // 2. 获取分支（前后端）
                    if (params.deployWay == 'Auto Select') {
                        // 2.1 根据分支流程规则，自动获取代码分支参数
                        def _branch = getBranch(params.deployType, params.envStage, params.version)
                        release_branch_front = _branch
                        release_branch_back = _branch
                        def cms = gitCodeKe(_branch, _branch)
                        release_commitid_back = cms.release_commitid_back
                        release_commitid_front = cms.release_commitid_front
                    } else if (params.deployWay == 'Manual Select') {
                        // 2.2 根据手动输入参数设定分支
                        paramsMap = input(
                            message: '请选择要开始的版本?',
                            ok: '确认！',
                            parameters: [
                                    string(name: 'commitId_back', defaultValue: '', description: '后端Repo(KAP)的branch或者commitid（必填）注：填commitid的时候前端的必填'),
                                    string(name: 'commitId_front', defaultValue: '', description: '前端repo(KAP_Frontend)的branch或者commitid（后端填分支名时，该参数可以不填）')
                            ],
                            // submitter:'liming.meng,admin',
                            submitterParameter: 'APPROVER'
                        )
                        release_branch_front = paramsMap['commitId_front']
                        release_branch_back = paramsMap['commitId_back']
                        def cms = gitCodeKe(release_branch_back, release_branch_front)
                        release_commitid_back = cms.release_commitid_back
                        release_commitid_front = cms.release_commitid_front
                    } else {
                        error(message: '请选择足够的信息来确认代码分支')
                    }
                }
            }
        }
        stage('2.1.Building Normal') {
            steps {
                script {
                    no_spark = false
                    def bp = buildPackage(params.version, params.envStage, params.deployType, no_spark, params.docs_commitid)
                    package_info = bp.package_info
                    println("build Normal [package_info]: ${package_info.file_name}, no_spark: ${no_spark}")
                }
            }
        }
        stage('2.2.Building noSpark') {
            when {
                expression {
                    return params.envStage in ['QA', 'RC', 'GA']
                }
            }
            steps {
                script {
                    no_spark = true
                    def bpns = buildPackage(params.version, params.envStage, params.deployType, no_spark, params.docs_commitid)
                    no_spark_package_info = bpns.no_spark_package_info
                    println("build noSpark [no_spark_package_info]: ${no_spark_package_info.toString()}, no_spark: ${no_spark}")
                }
            }
        }
        stage('3.Scan Public API') {
            when {
                expression {
                    return params.envStage == 'RC' || params.scanApi == true
                }
            }
            steps {
                container('build') {
                    timestamps {
                        script {
                            dir('sourcecode') {
                                sh script: """
                                    ls -lh
                                    wget https://repo-ofs.kyligence.com/repository/raw-tars-hosted/io.kyligence.ke/ke-api-inspector-release.tar.gz --directory-prefix=scanapi_workdir/
                                    tar -zxvf ./${package_info.file_name} -C ./scanapi_workdir > /dev/null
                                    tar -zxvf scanapi_workdir/ke-api-inspector-release.tar.gz -C ./scanapi_workdir > /dev/null

                                    ls -lh scanapi_workdir
                                    cd scanapi_workdir
                                    ke_pkg_home="`pwd`/${package_info.ga_name - '.tar.gz'}"
                                    cd ke-api-inspector-release
                                    ./run.sh \$ke_pkg_home
                                """

                                publishHTML([allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true, reportDir: 'scanapi_workdir/ke-api-inspector-release/report', reportFiles: 'ke_api_inspect_report.html', reportName: 'API 扫描报告', reportTitles: "report from ${BUILD_NUMBER}"])
                            }
                        }
                    }
                }
            }
        }
        stage('4.Dev/QA Upload') {
            parallel {
                stage('4.1.Upload to Azure CN') {
                    steps {
                        uplaodAzure(package_info)
                    }
                    post {
                        success {
                            sendNotify('EMAIL',
                                    "SUCCESSFUL to Upload the Tar into the Azure CN server'",
                                    // "liming.meng@kyligence.io",
                                    tester_emails,
                                    """<p>SUCCESSFUL: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]':</p>
                                <p>The Job upload the package ${package_info.file_name} to the Azure server: [159.27.120.141]</p>
                                <p>It saved in the path of [/home/4xuser/data/devops], please check it and use! Tks!</p>"""
                            )
                        }
                    }
                }
                // stage('4.2.Upload to Nexus') {
                //     steps {
                //         uploadNexus('raw-tars-hosted', package_info.package_path, package_info.file_name)
                //     }
                // }
                stage('4.2.Upload to AWS Global S3') {
                    when {
                        expression {
                            return params.envStage in ['QA', 'RC', 'GA']
                        }
                    }
                    steps {
                        println("upload to AWS S3 in Global: ${no_spark_package_info.file_name}")
                        // 上传S3：https://s3.console.aws.amazon.com/s3/buckets/download.kyligence.io?region=us-west-1&prefix=product/kap/4.0.x/&showversions=false
                        uploadAwsS3('us-west-2', 'aws_global_s3_cp', 'kyligencecloud-ci', "packages/ke-without-spark/${no_spark_package_info.file_name}", no_spark_package_info.file_name, 'nospark')
