#!groovy

@Library('devopslib') _

package_file = ''
namespace = 'test'

pipeline {
    options {
        timeout(time: 1, unit: 'HOURS')
    }

    agent {
        kubernetes {
            yamlFile 'pipelines/yaml/jenkins-package-agent.yaml'
        }
    }

    parameters {
        string(name: 'branch', defaultValue: 'newten-qa', description: 'Kap branch?')
        string(name: 'repo', defaultValue: 'Kyligence', description: 'Kap repo?')
        string(name: 'version', defaultValue: '4.5.x', description: 'Kap version?')
        credentials(name: 'certificate', credentialType: 'com.cloudbees.plugins.credentials.common.StandardCredentials', defaultValue: 'kyligence-git', required: true)
    }

    stages {
        stage("Checkout Source Code") {
            steps {
                container("build") {
                    dir("sourcecode") {
                        script {
                            retry(3) {
                                sshCmdWithCredentials(
                                    'bash -c /var/lib/git/pull.sh',
                                    'private_git',
                                    ['name':'localhost','host':'10.1.2.192', 'allowAnyHosts': true]
                                )
                                githubCheckout 'KAP'
                            }

                            echo 'checkout KAP_Frontend to kystudio'
                            sh 'rm -rf ./kystudio'
                            dir('kystudio') {
                                retry(3) {
                                    githubCheckout 'KAP_Frontend', "${branch ?: params.branch ?: 'newten-qa'}", 'https', 'github.com', '+refs/heads/*:refs/remotes/origin/*'
                                }
                            }
                        }
                    }
                }
            }
        }
        stage('Building Package') {
            steps {
                container("build") {
                    sh "cat /root/.m2/settings.xml"
                    dir("sourcecode") {
                        buildNewten(params.version, false, false)
                        archiveArtifacts artifacts: 'dist/*.tar.gz', fingerprint: true, followSymlinks: false, onlyIfSuccessful: true
                        script {
                            def commitid = sh(returnStdout:true, script: "git rev-parse --short HEAD | sed -e 's/\r//g'").trim()
                            print commitid

                            package_file=sh(returnStdout:true, script: """
                            mkdir -p /var/cicd/artifacts/dev/Newten-CD
                            package_name="artifacts/dev/Newten-CD/KE-${version}-DEV-${BUILD_NUMBER}-${commitid}.tar.gz"
                            cp dist/*.tar.gz /var/cicd/\$package_name"
                            echo "newten-cicd/\$package_name"
                            """).trim()
                            print package_file
                        }
                    }
                }
            }
        }
        stage("Generate ENV") {
            steps {
                container("kubectl") {

                    withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                        echo "查看 K8S 集群 Pod 列表"
                        sh "mkdir -p ~/.kube && cp ${KUBECONFIG} ~/.kube/config"
                    
                    // retry(3) {
                        script {
                            result = sh (
                                returnStatus: true,
                                script: """#!/bin/sh
                                    set +x
                                    cd ${WORKSPACE}/k8s/auto-generate/
                                    sh install.sh --package_file=${package_file} --namespace=${namespace}
                                """
                            ).trim()
                            if(result == 0){
                                print 'SUCCESS'
                                currentBuild.result = 'SUCCESS'
                            }else{
                                print 'FAILED'
                                currentBuild.result = 'FAILED'
                            }
                        }
                    // }
                    }
                }
            }
        }
    }
}
