  "cell_list" : [ {
    "id" : "5188",
    "content" : "-- CI 历史数据\n\nload FS.`s3a://k8s-bucket-devops/ke-ci-analyze/ci_build_result/build_result.csv` where\n`fs.s3a.endpoint`=\"s3.us-west-2.amazonaws.com\"\nand `fs.s3a.access.key`=\"AKIAWVFXNJCDKFY3VMXX\"\nand `fs.s3a.secret.key`=\"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\"\nand `fs.s3a.impl`=\"org.apache.hadoop.fs.s3a.S3AFileSystem\"\nand `fs.s3a.buffer.dir`=\"/tmp/oss\"\nand implClass=\"csv\"\nand `delimiter`=\"|\"\nas tmp_ci_build_result;\n\n\nselect \n`_c0` as `build_id`, `_c4` as `commit_id`, `_c12` as `pull_request_id`,\n`_c13` as `target_branch`, `_c13` as `origin_branch`, `_c17` as `committer`,\n`_c20` as `commit_message`, `_c23` as `trigger_by`,  `_c26` as `result`,\n`_c28` as `duration`, \ntimestamp_millis(cast(`_c29` as bigint)) as `build_timestamp`,\nto_date(timestamp_millis(cast(`_c29` as bigint)), 'yyyy-MM-dd') as `build_date`\nfrom tmp_ci_build_result as ci_build_reuslt;\n\nsave overwrite ci_build_reuslt as csv.`/datasources/byzer/ke4_ci_build_result.csv/` WHERE header=\"true\";\n\nselect count(*) from ci_build_reuslt as output;",
    "job_id" : "dc00a4a4-7cfa-4d4e-8258-012754eb016e"
  }, {
    "id" : "5189",
    "content" : "-- CI 测试用例历史执行数据\n\nload FS.`s3a://k8s-bucket-devops/ke-ci-analyze/ci_test_result/` where\n`fs.s3a.endpoint`=\"s3.us-west-2.amazonaws.com\"\nand `fs.s3a.access.key`=\"AKIAWVFXNJCDKFY3VMXX\"\nand `fs.s3a.secret.key`=\"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\"\nand `fs.s3a.impl`=\"org.apache.hadoop.fs.s3a.S3AFileSystem\"\nand `fs.s3a.buffer.dir`=\"/tmp/oss\"\nand implClass=\"csv\"\nas tmp_testcase_result;\n\nselect \n`_c0` as `build_id`, `_c1` as `test_suite`, `_c2` as `test_classname`, `_c3` as `method`, \ncast(`_c4` as int) as `duraion`, \n`_c5` as `result` from tmp_testcase_result as test_result;\n\nsave overwrite test_result as csv.`/datasources/byzer/ke4_ci_testcase_result.csv/` where header=\"true\";\n\nselect count(*) from test_result as output;\n",
    "job_id" : "47704ddd-42c0-4d9c-96cf-607b2fa09cfd"
  }, {
    "id" : "5190",
    "content" : "-- CD 历史数据\n\nload FS.`s3a://k8s-bucket-devops/ke-cd-analyze/cd_build_result/build_result.csv` where\n`fs.s3a.endpoint`=\"s3.us-west-2.amazonaws.com\"\nand `fs.s3a.access.key`=\"AKIAWVFXNJCDKFY3VMXX\"\nand `fs.s3a.secret.key`=\"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\"\nand `fs.s3a.impl`=\"org.apache.hadoop.fs.s3a.S3AFileSystem\"\nand `fs.s3a.buffer.dir`=\"/tmp/oss\"\nand implClass=\"csv\"\nand `delimiter`=\"|\"\nas tmp_cd_build_result;\n\nselect * from tmp_cd_build_result limit 10 as output;\n\n\nselect \n`_c0` as `build_id`, `_c1` as `deployWay`, `_c2` as `deployType`,\n`_c3` as `version`, `_c4` as `envStage`, `_c6` as `docs_commitid`,\n`_c7` as `scanApi`, `_c8` as `result`,  `_c9` as `duration`,\ntimestamp_millis(cast(`_c10` as bigint)) as `build_timestamp`,\nto_date(timestamp_millis(cast(`_c10` as bigint)), 'yyyy-MM-dd') as `build_date`\nfrom tmp_cd_build_result as cd_build_reuslt;\n\n\nsave overwrite cd_build_reuslt as csv.`/datasources/byzer/ke4_cd_build_result.csv/` WHERE header=\"true\";\n\nselect count(*) from cd_build_reuslt as output;",
    "job_id" : "61715e3c-e949-43fa-9d1a-11be7922b93d"
  } ],
  "is_demo" : null
